# PostgreSQL Config
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=real_estate_db
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432

# Qdrant Config
QDRANT_HOST=qdrant-db
QDRANT_PORT=6333

# --- NEW: Groq Config ---
GROQ_API_KEY=YOUR_GROQ_KEY_HERE

# --- Internal API key: shared secret between the app and the Airflow DAGs
# for POST /internal/parse-floorplan and /internal/embed. Not meant to be
# memorable -- generate one with e.g. `openssl rand -hex 32`.
INTERNAL_API_KEY=YOUR_INTERNAL_API_KEY_HERE

# --- Public API key: gates POST /ingest and POST /parse-floorplan-debug.
# Distinct from INTERNAL_API_KEY (that one's Airflow-only) -- the ui
# service holds this one and attaches it on the user's behalf. Generate
# with e.g. `openssl rand -hex 32`.
API_KEY=YOUR_API_KEY_HERE

# --- Airflow metadata DB (separate Postgres instance/container from the
# app's own postgres-db) ---
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# --- Airflow webserver admin user (local/demo only) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Fernet key for encrypting Airflow Connection passwords at rest. Generate
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=YOUR_FERNET_KEY_HERE

# --- Optional, both have sane defaults (Settings in src/config.py) ---
# LOG_LEVEL=INFO
# MAX_UPLOAD_SIZE_MB=15