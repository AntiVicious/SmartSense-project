# PostgreSQL Config
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=real_estate_db
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432

# Qdrant Config
QDRANT_HOST=qdrant-db
QDRANT_PORT=6333

# Groq Config
GROQ_API_KEY=YOUR_GROQ_KEY_HERE

# Shared secret between the API and the Airflow DAGs for /internal/*
# endpoints. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=YOUR_INTERNAL_API_KEY_HERE

# Required for POST /ingest and POST /parse-floorplan-debug. The ui service
# sends it on the user's behalf. Generate with: openssl rand -hex 32
API_KEY=YOUR_API_KEY_HERE

# Airflow metadata database (separate from the app's postgres-db)
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# Airflow webserver admin user (local use only)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Fernet key for encrypting Airflow Connection passwords at rest. Generate
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=YOUR_FERNET_KEY_HERE

# Optional settings with defaults (see src/config.py)
# LOG_LEVEL=INFO
# MAX_UPLOAD_SIZE_MB=15
# POSTGRES_SSLMODE=disable   # set to "require" for Neon/Supabase/managed Postgres