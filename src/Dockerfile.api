FROM python:3.10-slim
WORKDIR /app

# System libraries needed by OpenCV
RUN apt-get update && apt-get install -y \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Heavy dependencies (PyTorch, Ultralytics, EasyOCR) in their own layer so
# code changes don't reinstall them. Versions are pinned by constraints-api.txt.
COPY constraints-api.txt .
ENV PIP_CONSTRAINT=/app/constraints-api.txt
COPY requirements-heavy.txt .
RUN pip install --no-cache-dir -r requirements-heavy.txt

# Light dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Download the EasyOCR and embedding models at build time, so containers
# without persistent disk (e.g. Cloud Run) don't download them on every
# cold start.
RUN python -c "import easyocr; easyocr.Reader(['en'])"
RUN python -c "from langchain_community.embeddings import HuggingFaceEmbeddings; HuggingFaceEmbeddings(model_name='all-MiniLM-L6-v2')"

# Use the cached models at runtime without contacting the Hugging Face Hub.
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

# Keep src as a package, since api.py uses relative imports.
COPY src/ ./src/

# Model weights are published as a GitHub release asset and verified by checksum.
ARG MODEL_WEIGHTS_URL=https://github.com/AntiVicious/SmartSense-project/releases/download/model-weights-v1/best_1000.pt
ARG MODEL_WEIGHTS_SHA256=742fd385ac46ba7dea4c8a36c38c8014fe3b7f3c5bf9a8de9efb2947daea9545
RUN python -c "import urllib.request; urllib.request.urlretrieve('${MODEL_WEIGHTS_URL}', '/app/src/best_1000.pt')" \
    && echo "${MODEL_WEIGHTS_SHA256}  /app/src/best_1000.pt" | sha256sum -c -

COPY data /app/data

# Shell form so $PORT expands; Cloud Run sets PORT, local runs default to 8000.
CMD python -m uvicorn src.api:app --host 0.0.0.0 --port ${PORT:-8000}
