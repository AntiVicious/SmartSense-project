# The UI only calls the API over HTTP, so this image needs only Streamlit
# and requests.
FROM python:3.10-slim
WORKDIR /app

COPY constraints-ui.txt requirements-ui.txt ./
RUN PIP_CONSTRAINT=constraints-ui.txt pip install --no-cache-dir -r requirements-ui.txt

COPY src/main.py ./src/main.py

# Shell form so $PORT expands; Cloud Run sets PORT, local runs default to 8501.
CMD python -m streamlit run src/main.py --server.port ${PORT:-8501} --server.address 0.0.0.0
